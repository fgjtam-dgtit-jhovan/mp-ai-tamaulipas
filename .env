# Copia este archivo como ".env" y ajusta los valores antes de levantar el proyecto.
# NUNCA subas el archivo .env real a un repositorio (agrégalo a .gitignore).

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_DB=mpia_tamaulipas
POSTGRES_USER=mpia
POSTGRES_PASSWORD=changeme

# ── MinIO ───────────────────────────────────────────────────
MINIO_ROOT_USER=mpia_admin
MINIO_ROOT_PASSWORD=changeme123

# ── Qdrant ──────────────────────────────────────────────────
QDRANT_URL=http://qdrant:6333

# ── Ollama ──────────────────────────────────────────────────
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:14b

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Backend (Laravel, cuando exista) ───────────────────────
APP_ENV=local
APP_KEY=

APP_URL=http://localhost:8000
